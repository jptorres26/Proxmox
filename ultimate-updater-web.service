[Unit]
Description=Ultimate Updater web UI
# pve-cluster mounts /etc/pve, which holds the node certificate.
Wants=network-online.target pve-cluster.service
After=network-online.target pve-cluster.service

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/etc/ultimate-updater
# Default port when web-ui.conf is missing; the file overrides it.
Environment=WEB_UI_PORT=8765
EnvironmentFile=-/etc/ultimate-updater/web-ui.conf
ExecStart=/usr/bin/python3 /etc/ultimate-updater/web-ui/server.py --bind 0.0.0.0 --port ${WEB_UI_PORT}
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
UMask=0077
# Hardening that leaves file, device, and namespace access unchanged: the
# UI's own process tree may run pct exec, qm start, ssh, and pvesh. Options
# such as ProtectClock= (device allow-list: no /dev/ptmx, /dev/kvm),
# ProtectControlGroups=, RestrictNamespaces=, or MemoryDenyWriteExecute=
# (ctypes PAM callbacks) would break it.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
